{"nodes": [{"id": "skill_graft_skill", "label": "graft Skill (SKILL.md)", "file_type": "document", "source_file": ".claude/skills/graft/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skill_graft_ask", "label": "graft ask (locate + understand)", "file_type": "rationale", "source_file": ".claude/skills/graft/SKILL.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default tool: ranked retrieval with inlined <=8-line crux so no follow-up file read is needed; one ask per distinct sub-aspect, switch tools on weak hits."}, {"id": "skill_graft_grep", "label": "graft grep (exhaustive find)", "file_type": "rationale", "source_file": ".claude/skills/graft/SKILL.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ask is top-N and misses instances; grep is exhaustive and grouped by enclosing symbol. Loosen over-specific patterns rather than falling back to raw grep."}, {"id": "skill_graft_skeleton", "label": "graft skeleton (file API)", "file_type": "rationale", "source_file": ".claude/skills/graft/SKILL.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signatures-only view ~10x cheaper than reading the file."}, {"id": "skill_graft_callers", "label": "graft callers (call edges / blast radius)", "file_type": "rationale", "source_file": ".claude/skills/graft/SKILL.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Precomputed exact edges; --direction out for dependencies, --depth N / all for blast radius before rename or refactor."}, {"id": "skill_graft_map", "label": "graft map (repo orientation)", "file_type": "rationale", "source_file": ".claude/skills/graft/SKILL.md", "source_location": "L69", "source_url": null, "capt